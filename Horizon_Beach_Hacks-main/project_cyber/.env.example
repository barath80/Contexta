# Environment for docker-compose.yml. Copy to .env (never commit .env).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# REQUIRED
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional but recommended
GEMINI_API_KEY=            # enables LLM-written agent analysis and board reports (rules engine is used without it)
NVD_API_KEY=               # raises the NVD rate limit (https://nvd.nist.gov/developers/request-an-api-key)
INGEST_API_KEY=            # shared secret your SIEM / log shipper sends as X-API-Key to POST /api/v1/logs/ingest

# Where browsers reach the API, and which web origins the API accepts (JSON list)
PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000"]
# true only behind a trusted reverse proxy (otherwise rate limits key on the proxy, not the client)
TRUST_PROXY_HEADERS=false
