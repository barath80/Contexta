# Contexta backend configuration. Copy to .env (never commit .env).
APP_ENV=development            # development | test | production (production enforces strong secrets)
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console             # console | json

# Secrets - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Database: SQLite for local development, PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./contexta.db
# DATABASE_URL=postgresql+asyncpg://contexta:<password>@localhost:5432/contexta
# REDIS_URL=redis://localhost:6379/0     # optional: shared rate limiting

# First administrator, created on first start when no users exist (password: 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
ALLOW_REGISTRATION=false       # true lets people self-register as read-only viewers

# Threat intelligence
NVD_API_KEY=                   # optional; raises the NVD rate limit
CVE_FETCH_INTERVAL_HOURS=6
RISK_CALCULATION_INTERVAL_MINUTES=15
SYNC_FEEDS_ON_STARTUP=true

# AI agents (optional; the deterministic rules engine is used when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SIEM ingestion: shared secret sent as X-API-Key to POST /api/v1/logs/ingest
INGEST_API_KEY=

# Web origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

TRUST_PROXY_HEADERS=false      # true only behind a trusted reverse proxy that sets X-Forwarded-For
ALLOW_PRIVATE_WEBHOOKS=false   # webhooks may only target public addresses

RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
